# open-ticket API config (all optional — sensible dev defaults in src/config.ts).
PORT=5210
HOST=127.0.0.1

# Seat-hold TTL before lazy expiry (ms) and the optimistic-append retry budget.
HOLD_TTL_MS=600000
MAX_APPEND_ATTEMPTS=3

# CORS: the single web origin allowed to call the API (D3-05) — never a wildcard. Must match the
# web app's origin (apps/web runs on :5200).
WEB_ORIGIN=http://localhost:5200
